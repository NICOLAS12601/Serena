// Database schema. Each model is a table; see docs/04-modelo-de-datos.md
// (includes a Spanish glossary). The connection URL lives in prisma.config.ts.
//
// Conventions:
// - Money is stored as whole Uruguayan pesos (Int).
// - Instants use timestamptz (@db.Timestamptz) so they are unambiguous in UTC;
//   the business runs in America/Montevideo.

generator client {
  provider            = "prisma-client"
  // Generated TypeScript client; inside src/ so Nest compiles it. Not committed.
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalog and availability ────────────────────────────────────────────────

model Service {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  durationMin  Int
  price        Int
  imageUrl     String?
  // Icon shown next to the service (key of a fixed set drawn by the web app,
  // e.g. "lotus", "leaf", "waves", "wood-roller").
  icon         String?
  // The first-visit session ("Encuentro inicial"): offered only on the
  // "Es mi primer masaje" path, hidden from the returning-client list.
  isFirstVisit Boolean   @default(false)
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  bookings     Booking[]
}

// Recurring opening hours. Several rows per weekday allow split shifts
// (e.g. 09:00–13:00 and 15:00–19:00).
model WeeklySchedule {
  id           Int @id @default(autoincrement())
  weekday      Int // 0 = Sunday … 6 = Saturday
  startMinutes Int // minutes since midnight, e.g. 540 = 09:00
  endMinutes   Int
}

// Periods when no bookings are accepted (holidays, vacations, errands).
model TimeOff {
  id       Int      @id @default(autoincrement())
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?
}

// ─── Clients and bookings ────────────────────────────────────────────────────

// No password: a client is recognized by their mobile phone, stored in E.164
// (ADR-012). Email is optional and not used to send anything yet.
model Client {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  email     String?   @unique
  birthDate DateTime  @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  bookings  Booking[]
}

enum BookingStatus {
  PENDING_PAYMENT // paying with Mercado Pago; holds the slot until holdExpiresAt
  PENDING_VERIFICATION // paid by bank transfer; waiting for manual check
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  EXPIRED // hold ran out without payment; slot released
}

enum PaymentMethod {
  MERCADO_PAGO
  BANK_TRANSFER
}

// How much the client pays online when booking; the rest is paid after the session.
enum PaymentPlan {
  DEPOSIT // only the deposit (depositAmount)
  FULL // the whole price (priceSnapshot)
}

model Booking {
  id               Int           @id @default(autoincrement())
  clientId         Int
  client           Client        @relation(fields: [clientId], references: [id])
  serviceId        Int
  service          Service       @relation(fields: [serviceId], references: [id])
  startsAt         DateTime      @db.Timestamptz(3)
  endsAt           DateTime      @db.Timestamptz(3)
  // endsAt + buffer in force when booked; the no-overlap constraint uses
  // [startsAt, blockedUntil) (ADR-008). Added by a manual SQL migration.
  blockedUntil     DateTime      @db.Timestamptz(3)
  status           BookingStatus
  paymentMethod    PaymentMethod
  paymentPlan      PaymentPlan
  // Agreed at booking time; later price changes do not affect this booking.
  // The transfer discount, if any, is already applied.
  priceSnapshot    Int
  // The non-refundable part: lost when cancelling with less notice than the
  // policy allows; otherwise it carries over to the rescheduled booking.
  depositAmount    Int
  holdExpiresAt    DateTime?     @db.Timestamptz(3)
  // Reason for the visit (optional; Micaela follows up by WhatsApp).
  // Health data (Law 18.331): admin panel only.
  reason           String?
  privacyConsentAt DateTime      @db.Timestamptz(3)
  // Hash of the secret in the management link (ADR-009, ADR-012).
  manageTokenHash  String        @unique
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  payments         Payment[]

  @@index([clientId])
  @@index([serviceId])
  @@index([startsAt])
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// The payment method is stored once, in Booking.paymentMethod.
model Payment {
  id                   Int           @id @default(autoincrement())
  bookingId            Int
  booking              Booking       @relation(fields: [bookingId], references: [id])
  amount               Int
  status               PaymentStatus
  // Set for Mercado Pago payments; unique so a repeated webhook cannot
  // record the same payment twice.
  mercadoPagoPaymentId String?       @unique
  verifiedAt           DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)

  @@index([bookingId])
}

// ─── Configuration and admin ─────────────────────────────────────────────────

// Single row (id = 1) with the settings editable from the admin panel (ADR-006).
model Settings {
  id                      Int      @id @default(1)
  depositPercent          Int      @default(50)
  transferDiscountPercent Int      @default(10)
  mpHoldMinutes           Int      @default(10)
  transferHoldHours       Int      @default(2)
  bufferMinutes           Int      @default(15)
  minAdvanceHours         Int      @default(12)
  maxAdvanceDays          Int      @default(30)
  // Real business data is loaded from the panel, never committed (public repo).
  bankDetails             String?
  address                 String? // sent only once the booking is confirmed
  // For the "send transfer receipt by WhatsApp" button and the contact button.
  whatsappNumber          String?
  neighborhood            String? // shown on the public site
  cancellationPolicyText  String?
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  sessions     AdminSession[]
}

// Logged-in admin sessions (ADR-011). The cookie holds a random token; only
// its hash is stored, so a database leak does not expose usable sessions.
model AdminSession {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminUserId])
}
