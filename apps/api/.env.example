# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (the web runs on 3000)
PORT=3001

# PostgreSQL connection (local Docker or a Neon branch). Used once Prisma is added.
DATABASE_URL="postgresql://serena:serena@localhost:5432/serena"

# First admin user, created by the seed (pnpm db:seed) only if it does not exist.
# Use real values only in the hosting provider's settings, never in this file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Resend (https://resend.com): emails to Micaela about new bookings (ADR-012).
# Without a key, emails are only printed in the API console (development).
# Until the domain is verified in Resend, MAIL_FROM must be onboarding@resend.dev
# and Resend only delivers to the email of the Resend account owner.
RESEND_API_KEY=
MAIL_FROM="SERENA <onboarding@resend.dev>"

# Origin allowed to call the API from a browser (CORS)
WEB_ORIGIN=http://localhost:3000

# Number of proxies in front of the API, to read the visitor's real IP from
# X-Forwarded-For (rate limits). Leave unset locally. In production, check the
# value with GET /api/health: the "ip" it returns must be your own public IP.
# TRUST_PROXY=2
