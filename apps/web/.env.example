# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Base URL of the NestJS API. Used by the server (pages and the /api proxy);
# the browser never calls it directly.
API_URL=http://localhost:3001

# Key shared with the API (same value as INTERNAL_API_KEY in apps/api/.env).
# Optional locally; required in production, or the API rejects the web.
# INTERNAL_API_KEY=
